+#ifdef NAOMI_HOST
+/* Las envolventes que traen las secuencias (órdenes de envolvente de capa y de canal) son bytes de la secuencia, en
+ * el orden de N64; las de los bancos ya están en el de la SH-4. Sin convertirlas, {1, 32700} se lee {256, -17537}:
+ * la nota nace con volumen 0 y no se oye (el turbo, el derrape, la alarma de energía, la explosión). Se usa una copia
+ * convertida por dirección de origen, que se revisa en cada uso por si en esa dirección hay ya otra secuencia. */
+#define SEQ_ENV_SLOTS 48
+#define SEQ_ENV_POINTS 16
+static EnvelopePoint sSeqEnv[SEQ_ENV_SLOTS][SEQ_ENV_POINTS];
+static u8* sSeqEnvSrc[SEQ_ENV_SLOTS];
+static s32 sSeqEnvNext;
+
+static EnvelopePoint* AudioSeq_SeqEnvelope(u8* src) {
+    s32 i, k;
+    s32 same = false;
+
+    for (i = 0; i < SEQ_ENV_SLOTS; i++) {
+        if (sSeqEnvSrc[i] == src) {
+            break;
+        }
+    }
+    if (i == SEQ_ENV_SLOTS) {
+        i = sSeqEnvNext;
+        sSeqEnvNext = (sSeqEnvNext + 1) % SEQ_ENV_SLOTS;
+        sSeqEnvSrc[i] = src;
+    } else {
+        same = true;
+    }
+    for (k = 0; k < SEQ_ENV_POINTS; k++) {
+        s16 delay = (s16) ((src[k * 4] << 8) | src[k * 4 + 1]);
+        s16 arg = (s16) ((src[k * 4 + 2] << 8) | src[k * 4 + 3]);
+
+        if (same && (sSeqEnv[i][k].delay != delay || sSeqEnv[i][k].arg != arg)) {
+            same = false;
+        }
+        sSeqEnv[i][k].delay = delay;
+        sSeqEnv[i][k].arg = arg;
+        if (delay <= 0) {   /* ADSR_DISABLE, ADSR_HANG, ADSR_GOTO, ADSR_RESTART: fin de la envolvente */
+            break;
+        }
+    }
+    return sSeqEnv[i];
+}
