index 6ed5519..e1d108d 100644
--- a/include/PR/gbi.h
+++ b/include/PR/gbi.h
@@ -1139,6 +1139,15 @@ typedef struct {
 	u16 f[4][4];
 } Mtx_u;
 
+/* fzerox-naomi: Mtx_t empaqueta dos elementos por palabra de 32 bits (el entero de la columna c en la mitad alta,
+ * como guMtxF2L y gdSPDefMtx); en little-endian esa mitad es el u16 de índice c ^ 1, así que quien acceda por
+ * u.i/u.f usa MTXH(c) */
+#ifdef NAOMI_HOST
+#define MTXH(c) ((c) ^ 1)
+#else
+#define MTXH(c) (c)
+#endif
+
 typedef union {
     Mtx_t		m;
 	Mtx_u		u;
diff --git a/include/macros.h b/include/macros.h
index 429a175..d69a7cc 100644
--- a/include/macros.h
+++ b/include/macros.h
@@ -87,4 +87,11 @@
 #define OS_MSEC_TO_CYCLES(n)    OS_USEC_TO_CYCLES((n) * 1000LL)
 #define OS_SEC_TO_CYCLES(n)     OS_MSEC_TO_CYCLES((n) * 1000LL)
 
+// "¿empieza por MIO0?": leer la palabra como s32 solo vale en big-endian (fzerox-naomi: el SH-4 es little-endian)
+#ifdef NAOMI_HOST
+#define MIO0_MAGIC_AT(p) (((u8*) (p))[0] == 'M' && ((u8*) (p))[1] == 'I' && ((u8*) (p))[2] == 'O' && ((u8*) (p))[3] == '0')
+#else
+#define MIO0_MAGIC_AT(p) (*(s32*) (p) == (s32) 'MIO0')
+#endif
+
 #endif // MACROS_H
