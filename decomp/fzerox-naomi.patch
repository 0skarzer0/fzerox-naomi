+// "¿empieza por MIO0?": leer la palabra como s32 solo vale en big-endian (fzerox-naomi: el SH-4 es little-endian)
+#ifdef NAOMI_HOST
+#define MIO0_MAGIC_AT(p) (((u8*) (p))[0] == 'M' && ((u8*) (p))[1] == 'I' && ((u8*) (p))[2] == 'O' && ((u8*) (p))[3] == '0')
+#else
+#define MIO0_MAGIC_AT(p) (*(s32*) (p) == (s32) 'MIO0')
+#endif
+
 #endif // MACROS_H
